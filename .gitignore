# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.hypothesis/

# Node / frontend
node_modules/
frontend/dist/
frontend/node_modules/

# Generated sample videos (regenerate with: python -m vision.samples.make_samples)
vision/samples/*.mp4

# IaC build artifacts
infra/cdk.out/
infra/node_modules/

# Local env / secrets - never commit credentials (Requirement 18.5)
.env
.env.*
*.pem

# OS / editor
.DS_Store
Thumbs.db

# Fetched ONNX model weights (see vision/models/MODEL_MANIFEST.md)
vision/models/*.onnx

# --- AgentCore CLI generated artifacts (do NOT commit vendored deps / cache) ---
# The @aws/agentcore project keeps build cache, staging copies of third-party
# libraries, a venv, and a generated CDK app under these paths. Keep only our
# real agent source (app/roadguard/main.py + agent/ + vision/) which is tracked
# explicitly; ignore everything generated.
agentcore_app/**/.cache/
agentcore_app/**/.venv/
agentcore_app/**/node_modules/
agentcore_app/**/cdk/node_modules/
agentcore_app/**/.cli/logs/
agentcore_app/**/cdk.out/
agentcore_app/**/app/**/.venv/
**/.cache/
# CDK synth scratch (any location)
cdk.out/
cdk.out.*/
# build/debug logs
*.log
# Amplify
amplify/
.amplify/

# AgentCore CLI-generated deployment project (contains its own .git + vendored
# deps). The REAL agent source is tracked at the repo root: agent/ and
# agentcore/agent_entrypoint.py. This folder is regenerated by `agentcore create`
# + `agentcore add agent` and is excluded from the repo to keep it clean.
agentcore_app/
